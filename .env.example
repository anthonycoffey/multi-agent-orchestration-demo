# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=

# Scoped PAT for the target repository.
# MUST NOT carry `workflow` scope — see ADR-003. An agent able to edit
# .github/workflows/** can print every secret in CI.
YM_GITHUB_TOKEN=

YM_TARGET_REPO=anthonycoffey/coffey.codes

# --- Admission (ADR-003 layer 1) ------------------------------------------
YM_ADMISSION_LABEL=agent-ready
YM_AUTHOR_ALLOWLIST=anthonycoffey

# --- Intake thresholds (SPEC-001) -----------------------------------------
YM_READINESS_THRESHOLD=70
YM_MAX_CRITERIA=8
YM_MAX_FILE_HINTS=12

# --- Fleet limits (SPEC-002, SPEC-004) ------------------------------------
YM_MAX_CONCURRENT=3
YM_BUDGET_PER_ISSUE_USD=2.00
YM_BUDGET_FLEET_DAILY_USD=25.00

# --- Storage (SPEC-008) ---------------------------------------------------
# Absent means the in-memory store. Postgres is the opt-in compose profile.
# YM_STORE_DSN=postgresql://yardmaster:yardmaster@localhost:5432/yardmaster

# --- Observability (SPEC-007) ---------------------------------------------
# Absent means spans are logged rather than exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
